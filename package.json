{
  "name": "@saucelabs/mobile-beta-react-native",
  "version": "3.1.0",
  "description": "Sauce Mobile Beta SDK for React Native, formerly TestFairy. Crashless and designed to coexist with Backtrace Error Reporting.",
  "main": "./index.js",
  "types": "./index.d.ts",
  "react-native": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "react-native": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android",
    "ios",
    "local-native",
    "docs",
    "index.js",
    "index.d.ts",
    "react-native.config.js",
    "SauceMobileBetaReactNative.podspec",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint index.js __tests__ react-native.config.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit --project tsconfig.types.json",
    "validate:package": "bash scripts/validate-package.sh",
    "prepack": "npm run lint && npm run test && npm run typecheck && npm run validate:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testfairy/react-native-testfairy.git"
  },
  "bugs": {
    "url": "https://github.com/testfairy/react-native-testfairy/issues"
  },
  "homepage": "https://github.com/testfairy/react-native-testfairy#readme",
  "keywords": [
    "sauce-labs",
    "sauce-mobile-beta",
    "testfairy",
    "react-native",
    "ios",
    "android",
    "beta-testing",
    "feedback",
    "session-recording",
    "backtrace"
  ],
  "author": "Sauce Labs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@backtrace/react-native": ">=0.2.2",
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "peerDependenciesMeta": {
    "@backtrace/react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "sauceMobileBetaNative": {
    "ios": "2.3.0",
    "android": "2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
